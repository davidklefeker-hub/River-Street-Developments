# =============================================================================
# CompanyCam ↔ Property Management work order loop
# =============================================================================

# Personal access token: https://app.companycam.com/access_tokens
COMPANYCAM_ACCESS_TOKEN=your_companycam_access_token

# Optional. Email of the CompanyCam user credited as the creator of automated
# comments, photos and checklists. Without it they show as the integration.
COMPANYCAM_ACT_AS_USER=

# --- Field → work order trigger -----------------------------------------------
# Photo tags that mean "this needs a work order". Cleaners apply these in the
# field; they must exist in CompanyCam (run `npm run wo:doctor` to check).
COMPANYCAM_DAMAGE_TAGS=Damage,Repair Needed

# Photo tag → work order category, so requests arrive pre-classified.
COMPANYCAM_CATEGORY_TAGS=plumbing=Plumbing,electrical=Electrical,hvac=HVAC,appliance=Appliance,drywall=Drywall,paint=Paint,flooring=Flooring,roof=Roofing,pest=Pest Control

# Photo tag → priority.
COMPANYCAM_PRIORITY_TAGS=emergency=emergency,urgent=emergency,high priority=high,routine=low
COMPANYCAM_DEFAULT_PRIORITY=medium

# Label added to a project once a request has been raised from it, so the crew
# can see their report was picked up. Set empty to disable.
COMPANYCAM_RAISED_LABEL=WO Requested

# Optional. Work order category → CompanyCam checklist template NAME. The API
# can only attach templates that already exist in CompanyCam.
# COMPANYCAM_CHECKLIST_TEMPLATES=turnover=Unit Turnover,plumbing=Plumbing Repair

# --- Webhook receiver (optional, low-latency; keep the poller running too) -----
COMPANYCAM_WEBHOOK_TOKEN=
COMPANYCAM_WEBHOOK_PORT=3000

# --- Polling window -----------------------------------------------------------
# Re-scan this far behind the last poll, so photos uploaded late aren't missed.
POLL_LOOKBACK_SECONDS=3600
POLL_INITIAL_LOOKBACK_SECONDS=86400
POLL_MAX_PAGES=10

# --- Where new work order requests go -----------------------------------------
# file  — writes a paste-ready brief to the outbox (use this with Yardi Breeze,
#         which has no write API; also the safest way to test the loop)
# email — sends the brief over SMTP to a coordinator or an intake address
# rest  — POSTs to a work order API (DoorLoop, Buildium) or an automation webhook
WORKORDER_SINK=file

WORKORDER_OUTBOX_FOLDER=./outbox

WORKORDER_EMAIL_TO=
WORKORDER_EMAIL_FROM=
WORKORDER_EMAIL_CC=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

WORKORDER_REST_URL=
WORKORDER_REST_METHOD=POST
WORKORDER_REST_AUTH=
# Path to a JSON field-mapping template (see docs/workorder-loop/README.md).
# Omit to post the normalized request as-is, which is what a Zapier or Make
# catch hook expects.
WORKORDER_REST_TEMPLATE=
WORKORDER_REST_HEADERS=

# Tracks what has already been synced so reruns don't duplicate work.
WORKORDER_STATE_FILE=./.workorder-state.json

# Folder watched for Breeze exports (.csv) and saved notifications (.eml/.txt)
WATCH_FOLDER=./incoming
PROCESSED_FOLDER=./processed


# =============================================================================
# CompanyCam → Asana document pipeline (the original pipeline in this repo)
# =============================================================================

ASANA_ACCESS_TOKEN=your_asana_personal_access_token
ASANA_WORKSPACE_ID=your_workspace_id

# User GIDs from Asana (find via Asana API: GET /users/me)
ASANA_ASSIGNEE_GID=your_user_gid
ASANA_FOLLOWER_JOSH_GID=josh_user_gid
ASANA_FOLLOWER_BARRY_GID=barry_user_gid
